// REVIEW ONLY. Not authorization to deploy. No secrets in vars.
{
  "name": "qy-c1-consultation-preview",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-07",
  "d1_databases": [],
  "vars": {
    "CONSULTATION_DEPLOYMENT_SLOT": "disabled",
    "CONSULTATION_CONFIG": "{}",
    "CONSULTATION_PREVIEW_ENABLED": "false",
    "CONSULTATION_SYNTHETIC_BOOTSTRAP_ENABLED": "false",
    "CONSULTATION_MOCK_DELIVERY_ENABLED": "false",
    "SUBSCRIPTION_AUTOMATION_ENABLED": "false"
  },
  "env": {
    "production": {
      "d1_databases": [],
      "vars": {
        "CONSULTATION_DEPLOYMENT_SLOT": "disabled",
        "CONSULTATION_CONFIG": "{}",
        "CONSULTATION_PREVIEW_ENABLED": "false",
        "CONSULTATION_SYNTHETIC_BOOTSTRAP_ENABLED": "false",
        "CONSULTATION_MOCK_DELIVERY_ENABLED": "false",
        "SUBSCRIPTION_AUTOMATION_ENABLED": "false"
      }
    },
    "preview": {
      "d1_databases": [
        {
          "binding": "CONSULTATION_DB",
          "database_name": "qy-c1-consultation-preview-db",
          "database_id": "OWNER_ATTESTED_NEW_DATABASE_UUID_REQUIRED"
        }
      ],
      "vars": {
        "CONSULTATION_DEPLOYMENT_SLOT": "preview",
        "CONSULTATION_CONFIG": "{}",
        "CONSULTATION_PREVIEW_ENABLED": "false",
        "CONSULTATION_SYNTHETIC_BOOTSTRAP_ENABLED": "false",
        "CONSULTATION_MOCK_DELIVERY_ENABLED": "false",
        "SUBSCRIPTION_AUTOMATION_ENABLED": "false"
      }
    }
  }
}
