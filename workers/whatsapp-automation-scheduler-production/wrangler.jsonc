{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qy-whatsapp-automation-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "vars": {
    "AUTOMATION_BASE_URL": "https://quantumyijing.com/api/admin/whatsapp-automation"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false
    }
  }
}
